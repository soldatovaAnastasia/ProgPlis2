{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run GTK-wave",
			"type": "process",
			"command": "gtkwave",
			"args": [
				"${workspaceFolder}/out/waveform.vcd"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"windows": {
				"command": "gtkwave.exe"
			}
		}
	]
}
